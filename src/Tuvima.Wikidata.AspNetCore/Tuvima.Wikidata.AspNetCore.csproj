<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet package metadata -->
    <PackageId>Tuvima.Wikidata.AspNetCore</PackageId>
    <Version>3.10.1</Version>
    <Authors>Tuvima</Authors>
    <Description>ASP.NET Core middleware for hosting a W3C Reconciliation Service API backed by Wikidata. Exposes the Tuvima.Wikidata library as an OpenRefine-compatible HTTP endpoint.</Description>
    <PackageTags>wikidata;reconciliation;openrefine;w3c;aspnetcore;middleware</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.tuvima.com/libraries/wikidata/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tuvima/wikidata</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Ship XML docs so consumers get IntelliSense; publish symbols and reproducible builds. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documented members ship in IntelliSense; undocumented DTO members don't fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Fail pack on accidental breaking changes against the last published version. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.9.1</PackageValidationBaselineVersion>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tuvima.Wikidata\Tuvima.Wikidata.csproj" />
  </ItemGroup>

</Project>
